page {
  background: linear-gradient(180deg, #F8FAFC 0%, #F1F5F9 100%);
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  overflow: hidden;
}

.app-container {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.header-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 90rpx;
  margin-bottom: 50rpx;
}

.logo-box {
  width: 140rpx;
  height: 140rpx;
  background: #ffffff;
  border-radius: 50%;
  box-shadow: 0 10rpx 30rpx rgba(16, 185, 129, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 30rpx;
}

.logo-icon {
  font-size: 60rpx;
  z-index: 2;
}

.radar-scan {
  position: absolute;
  top: -10rpx;
  left: -10rpx;
  right: -10rpx;
  bottom: -10rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(16, 185, 129, 0.3);
  animation: pulse-ring 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
}

@keyframes pulse-ring {
  0% { transform: scale(0.8); opacity: 0.8; }
  80%, 100% { transform: scale(1.4); opacity: 0; }
}

.main-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #111827;
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
}

.sub-title {
  font-size: 26rpx;
  color: #64748B;
}

.control-panel {
  padding: 0 40rpx;
  margin-bottom: 40rpx;
}

.btn-group {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.05);
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(90deg, #34d399 0%, #10b981 100%);
  color: #ffffff;
  flex: 1.5; /* 扫描按钮稍大 */
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.25);
}

.btn-primary:active {
  background: linear-gradient(90deg, #10b981 0%, #059669 100%);
  transform: translateY(2rpx);
}

.btn-danger {
  background: #ffffff;
  color: #EF4444;
}
.btn-danger:active {
  background: #FEF2F2;
  transform: translateY(2rpx);
}

.btn-ghost {
  background: #ffffff;
  color: #64748B;
}
.btn-ghost:active {
  background: #F1F5F9;
  transform: translateY(2rpx);
}

.list-container {
  flex: 1;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 30rpx;
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
}

.list-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 0 10rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1F2937;
}

.device-list {
  flex: 1;
  height: 0; /* 让 scroll-view 正常撑开容器 */
}

.device-card {
  display: flex;
  align-items: center;
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1px solid rgba(0, 0, 0, 0.02);
  transition: all 0.2s ease;
}

.device-card-hover {
  background: #F1F5F9;
  transform: scale(0.98);
  box-shadow: inset 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.device-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(16, 185, 129, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
}

.device-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.device-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #111827;
  margin-bottom: 8rpx;
}

.device-mac {
  font-size: 22rpx;
  color: #94A3B8;
}

.device-signal {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.signal-value {
  font-size: 34rpx;
  font-weight: 900;
}

.signal-strong { color: #10B981; }
.signal-medium { color: #F59E0B; }
.signal-weak { color: #EF4444; }

.signal-dbm {
  font-size: 20rpx;
  color: #94A3B8;
  margin-top: 4rpx;
}

.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 100rpx; /* 中心上调一点点 */
}

.empty-icon-box {
  width: 160rpx;
  height: 160rpx;
  background: #F8FAFC;
  border: 2rpx dashed #CBD5E1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #94A3B8;
}
