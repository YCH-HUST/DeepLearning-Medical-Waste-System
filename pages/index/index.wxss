/**index.wxss**/
page {
  margin-top: 700rpx;
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #aaa;
  width: 80%;
}

.userinfo-avatar {
  overflow: hidden;
  width: 128rpx;
  height: 128rpx;
  margin: 20rpx;
  border-radius: 50%;
}

.usermotto {
  margin-top: 200px;
}

.avatar-wrapper {
  padding: 0;
  width: 56px !important;
  border-radius: 8px;
  margin-top: 40px;
  margin-bottom: 40px;
}

.avatar {
  display: block;
  width: 56px;
  height: 56px;
}

.nickname-wrapper {
  display: flex;
  width: 100%;
  padding: 16px;
  box-sizing: border-box;
  border-top: .5px solid rgba(0, 0, 0, 0.1);
  border-bottom: .5px solid rgba(0, 0, 0, 0.1);
  color: black;
}

.nickname-label {
  width: 105px;
}

.nickname-input {
  flex: 1;
}

/* 过渡动画样式 */
.transition-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 9999;
  animation: fadeIn 0.3s ease-in-out;
}

.pink-circle-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 30rpx;
}

.pink-circle {
  width: 20rpx;
  height: 20rpx;
  background: linear-gradient(45deg, #ff69b4, #ff1493);
  border-radius: 50%;
  margin: 0 8rpx;
  animation: pinkPulse 1.5s ease-in-out infinite;
  box-shadow: 0 0 20rpx rgba(255, 105, 180, 0.6);
}

.pink-circle:nth-child(2) {
  animation-delay: 0.2s;
}

.pink-circle:nth-child(3) {
  animation-delay: 0.4s;
}

.transition-text {
  color: white;
  font-size: 32rpx;
  font-weight: 500;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  animation: textGlow 2s ease-in-out infinite;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes pinkPulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.7;
  }
  50% {
    transform: scale(1.3);
    opacity: 1;
  }
}

@keyframes textGlow {
  0%, 100% {
    text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  }
  50% {
    text-shadow: 0 2rpx 20rpx rgba(255, 255, 255, 0.5);
  }
}

.device_item_hover {
  background-color: #f0f0f0;
}

.connected_info {
  margin-top: 20px;
  padding: 10px;
  background-color: #e8f5e8;
  border-radius: 5px;
}

.operation {
  margin-top: 10px;
}
