// 风扇控制功能
toggleFan: function(e) {
  const isFanOn = e.detail.value;
  if (isFanOn) {
    this.setData({ fanStatus: "开启" });
    this.sendToBluetooth("FAN_ON");
  } else {
    this.setData({ fanStatus: "关闭" });
    this.sendToBluetooth("FAN_OFF");
  }
},

// RGB灯控制功能
onRedChange: function(e) {
  this.setData({
    redValue: e.detail.value,
    lightOn: true, // 手动调节时自动打开主开关
    selectedPresetIndex: null // 清除预设选择
  });
  this.sendRGBToBluetooth();
},

onGreenChange: function(e) {
  this.setData({
    greenValue: e.detail.value,
    lightOn: true, // 手动调节时自动打开主开关
    selectedPresetIndex: null // 清除预设选择
  });
  this.sendRGBToBluetooth();
},

onBlueChange: function(e) {
  this.setData({
    blueValue: e.detail.value,
    lightOn: true, // 手动调节时自动打开主开关
    selectedPresetIndex: null // 清除预设选择
  });
  this.sendRGBToBluetooth();
},

// RGB预设功能
onPresetChange: function(e) {
  const index = e.detail.value;
  this.setPresetByIndex(index);
},

setPresetByIndex: function(index) {
  const preset = this.data.lightPresets[index];
  if (!preset) return;

  const rgbValues = preset.rgb.split(',').map(Number);
  
  this.setData({
    selectedPresetIndex: index,
    redValue: rgbValues[0],
    greenValue: rgbValues[1],
    blueValue: rgbValues[2],
    lightOn: true,
  });
  this.sendRGBToBluetooth();
},

setOff: function() {
  this.setData({
    redValue: 0,
    greenValue: 0,
    blueValue: 0,
    lightOn: false, // 关闭时联动主开关
    selectedPresetIndex: null // 清除预设选择
  });
  this.sendRGBToBluetooth();
},

// 发送RGB数据到蓝牙
sendRGBToBluetooth: function() {
// ... existing code ...
  const rgbStr = `RGB=${this.data.redValue},${this.data.greenValue},${this.data.blueValue}`;
  this.sendToBluetooth(rgbStr);
},

// 发送数据到蓝牙
