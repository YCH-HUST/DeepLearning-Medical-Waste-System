// 主光源开关
toggleLight: function(e) {
  const isOn = e.detail.value;
  if (isOn) {
    this.setData({ lightOn: true });
    // 打开时默认设置为白光
    this.setPresetByIndex(8); // 8 是白色光的索引
  } else {
    // 关闭时所有灯光熄灭
    this.setOff();
  }
},

