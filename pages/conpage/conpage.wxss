/* 连接状态显示 */
.connection-status {
  position: fixed;
  top: 20rpx;
  right: 20rpx;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 10rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  backdrop-filter: blur(10rpx);
  border: 1px solid rgba(76, 175, 80, 0.3);
}

.connection-status.reconnecting {
  background: rgba(255, 193, 7, 0.9);
  border-color: #ffc107;
}

.status-text {
  color: #1F2937;
  font-size: 24rpx;
  font-weight: 500;
}

.connection-status.reconnecting .status-text {
  color: #000000;
}

.status-indicator {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffc107;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.5;
    transform: scale(1.2);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* 页面基础样式 */
page {
  height: 100%;
  margin: 0;
  padding: 0;
  color: #1F2937;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  overflow: hidden; /* 防止滑动时露出白色背景 */
  background: linear-gradient(180deg, #F8FAFC 0%, #F1F5F9 100%); /* 层次感背景 */
}

/* 页面根容器 */
.page {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.background {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0; /* 确保背景图片贴合页面顶部 */
  left: 0; /* 确保背景图片贴合页面左侧 */
  background-size: cover;
  opacity: 0.9;
  z-index: -1;
}

/* 页面容器 */
.page-container {
  width: 400%; /* 四个页面的总宽度 */
  height: 100vh;
  display: flex;
  transform: translateX(0);
  transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.page-container.monitor {
  transform: translateX(0);
}

.page-container.classification {
  transform: translateX(-25%);
}

.page-container.device {
  transform: translateX(-50%);
}

.page-container.rgb {
  transform: translateX(-75%);
}

/* 页面内容 */
.page-content {
  width: 25%; /* 每个页面占容器宽度的1/4 */
  height: 100%;
  overflow-y: auto;
  padding-bottom: 120rpx; /* 为底部切换栏留出空间 */
  flex-shrink: 0; /* 防止页面被压缩 */
}

.page-content.active {
  display: block; /* 显示激活的页面 */
}

.content {
  padding: 20rpx;
  overflow: hidden; /* 禁止该区域滚动 */
}

.title {
  margin-top: 60rpx;
  margin-bottom: 40rpx;
  text-align: center;
  position: relative;
  padding-bottom: 20rpx;
}

.title::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 100rpx;
  height: 6rpx;
  background: linear-gradient(to right, #34d399, #059669);
  border-radius: 3rpx;
}

.main-title {
  font-size: 56rpx;
  font-weight: 900;
  color: #111827;
  font-family: inherit;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 12rpx;
}

.sub-title {
  font-size: 28rpx;
  color: #64748B;
  font-weight: 500;
}

/* 分节样式 */
.section {
  margin-bottom: 24rpx;
  background-color: transparent; /* 去除原本的框，让内部卡片悬浮 */
  padding: 5rpx 0rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #1F2937;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}
.section-title::before {
  content: '';
  display: inline-block;
  height: 32rpx;
  width: 8rpx;
  background-color: #10B981;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

/* 数据网格样式 */
.data-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15rpx;
  margin-bottom: 10rpx;
}

.data-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.05);
  border: 1px solid rgba(46, 125, 50, 0.08);
  min-height: 110rpx;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.data-card:active {
  transform: scale(0.97);
}

.data-label {
  font-size: 24rpx;
  color: #64748B;
  margin-bottom: 8rpx;
}

.data-value {
  font-size: 36rpx;
  font-weight: 900;
  color: #111827;
}

/* 医疗废物监测卡片 */
.waste-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.05);
  border: 1px solid rgba(46, 125, 50, 0.08);
}

.waste-details {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.waste-icon-and-label {
    display: flex;
    align-items: center;
    gap: 15rpx;
}

.waste-icon {
  font-size: 40rpx;
}

.waste-label {
  font-size: 28rpx;
  color: #64748B;
}

.waste-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #1F2937;
}

.waste-value-container {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.waste-unit {
  font-size: 24rpx;
  color: #64748B;
  font-weight: normal;
}

.waste-progress-bar {
  width: 100%;
}

/* 底部切换栏样式 */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  display: flex;
  border-top: none;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
  z-index: 1000;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
}

.tab-item.active {
  transform: translateY(-5rpx);
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #10b981;
  border-radius: 2rpx;
  animation: slideIn 0.3s ease-out;
}

@keyframes slideIn {
  from {
    width: 0;
  }
  to {
    width: 40rpx;
  }
}

.tab-icon {
  font-size: 32rpx;
  margin-bottom: 5rpx;
}

.tab-text {
  font-size: 20rpx;
  color: #64748B;
}

.tab-item.active .tab-text {
  color: #10b981;
  font-weight: bold;
}

/* 页面标题 */
.page-title {
  font-size: 56rpx;
  font-weight: 900;
  color: #111827;
  text-align: center;
  margin-top: 50rpx;
  margin-bottom: 60rpx;
  font-family: inherit;
  letter-spacing: 2rpx;
  position: relative;
  padding-bottom: 20rpx;
  width: 100%;
  display: block;
}

.page-title::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 100rpx;
  height: 6rpx;
  background: linear-gradient(to right, #34d399, #059669);
  border-radius: 3rpx;
}

/* 控制卡片样式 */
.control-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 26rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.06);
  border: 1px solid rgba(46, 125, 50, 0.08);
}

.control-card.modern {
  padding: 26rpx;
}

.control-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.control-title-group {
    display: flex;
    align-items: center;
    gap: 20rpx;
}

.control-icon {
    font-size: 40rpx;
}

.control-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1F2937;
}

.status-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20rpx;
    padding-top: 10rpx;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
}

.status-item {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.status-label {
    font-size: 24rpx;
    color: #64748B;
    opacity: 0.8;
    margin-bottom: 8rpx;
}

.status-value {
    font-size: 26rpx;
    color: #1F2937;
    font-weight: bold;
}

.status-value.connected {
    color: #4db6ac;
}

.rgb-preview {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(76, 175, 80, 0.2);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.rgb-controls {
  margin-top: 16rpx; /* 与标题分开 */
  margin-bottom: 16rpx;
}

/* 亮度调节样式 */
.brightness-control {
  margin-top: 16rpx; /* 与标题分开 */
  margin-bottom: 16rpx;
}

.slider-container {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 20rpx;
  padding: 12rpx 0; /* 增加上下内边距，扩大触摸区域 */
}

.slider-label {
  font-size: 26rpx;
  color: #1F2937;
  font-weight: bold;
  min-width: 120rpx;
  text-shadow: none;
}

.slider-bar {
  flex: 1;
  margin: 0 15rpx;
}

.slider-value {
  font-size: 24rpx;
  color: #64748B;
  font-weight: bold;
  min-width: 60rpx;
  text-align: center;
  background-color: #f2f9f1;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  border: 1px solid rgba(76, 175, 80, 0.2);
}

/* 仅设置轨道高度和圆角，颜色和大小由WXML属性控制 */
slider.slider-bar .wx-slider-track {
    height: 8rpx !important;
    border-radius: 4rpx !important;
}

/* 为所有滑块手柄添加阴影，增强质感 */
slider.slider-bar .wx-slider-handle {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2) !important;
}

/* 预设方案 */
.preset-section {
    margin-bottom: 20rpx;
}

.preset-title {
    font-size: 28rpx;
    color: #64748B;
    opacity: 0.8;
    margin-bottom: 20rpx;
    display: block;
    text-align: center;
}

.preset-list {
    display: flex;
    flex-direction: column;
    gap: 15rpx;
}

.preset-item {
    background-color: #ffffff;
    border-radius: 12rpx;
    padding: 20rpx;
    display: flex;
    align-items: center;
    gap: 20rpx;
    transition: background-color 0.2s ease;
}

.preset-item:active {
    background-color: #e8f5e9;
}

.preset-icon {
    font-size: 40rpx;
    width: 50rpx;
    text-align: center;
}

.preset-text {
    display: flex;
    flex-direction: column;
}

.preset-name {
    font-size: 26rpx;
    font-weight: bold;
    color: #1F2937;
}

.preset-desc {
    font-size: 22rpx;
    color: #64748B;
    opacity: 0.7;
}

/* 灯光效果按钮样式 */
.effect-buttons {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.effect-btn {
  height: 60rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background-color: #10b981;
  color: #ffffff;
  border: none;
}

.effect-btn:active {
  background-color: #059669;
}

.picker-display {
    background-color: #ffffff;
    border: 1px solid rgba(76, 175, 80, 0.2);
    border-radius: 12rpx;
    padding: 22rpx 25rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #1F2937;
    font-size: 28rpx;
}

.picker-arrow {
    font-size: 28rpx;
    color: #64748B;
    opacity: 0.7;
}

.preset-description-card {
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 12rpx;
    padding: 22rpx;
    margin-top: 12rpx;
    animation: fadeIn 0.3s ease-in-out;
}

.desc-title {
    display: block;
    font-size: 26rpx;
    font-weight: bold;
    color: #1F2937;
    margin-bottom: 10rpx;
}

.desc-text {
    font-size: 24rpx;
    color: #64748B;
    line-height: 1.5;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 页面加载状态 */
.page.loading {
  overflow: hidden;
}

.page.loading .page-container {
  opacity: 0;
  pointer-events: none;
}

/* 数据读取动画样式 */
.data-loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: linear-gradient(135deg, #f2f9f1 0%, #e8f5e9 50%, #c8e6c9 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 99999;
  animation: fadeIn 0.3s ease-in-out;
  /* 确保动画层从一开始就完全覆盖 */
  opacity: 1;
  visibility: visible;
}

/* 当不显示动画时，完全隐藏覆盖层 */
.data-loading-overlay[hidden] {
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease-out, visibility 0.3s ease-out;
}

.white-ring-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 40rpx;
}

.white-ring {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(76, 175, 80, 0.2);
  border-top: 6rpx solid #10b981;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  box-shadow: 0 0 30rpx rgba(76, 175, 80, 0.3);
}

.loading-text {
  color: #1F2937;
  font-size: 32rpx;
  font-weight: 500;
  text-shadow: none;
  animation: textPulse 2s ease-in-out infinite;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

@keyframes textPulse {
  0%, 100% {
    opacity: 0.8;
  }
  50% {
    opacity: 1;
  }
}

/* 去皮控制样式 */
.tare-control {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 20rpx 0;
}

.tare-description {
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.4;
  text-align: center;
}

.tare-button {
  background: linear-gradient(135deg, #66bb6a 0%, #43a047 100%);
  border: none;
  border-radius: 12rpx;
  padding: 25rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}

.tare-button:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.4);
  background: linear-gradient(135deg, #43a047 0%, #059669 100%);
}

.tare-button[disabled] {
  background: linear-gradient(135deg, #666 0%, #555 100%);
  opacity: 0.6;
  box-shadow: none;
}

.tare-button[disabled]:active {
  transform: none;
  box-shadow: none;
}

.tare-button-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  text-shadow: none;
}

/* AI智能分类样式 */
.classification-card {
  background-color: #ffffff;
  border: 1px solid rgba(76, 175, 80, 0.15);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 25rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.06);
}

.classification-details {
