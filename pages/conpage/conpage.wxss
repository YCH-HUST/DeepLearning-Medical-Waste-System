  color: #1F2937;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.upload-btn {
  margin: 24rpx 0 24rpx 0;
  width: 90%;
  height: 90rpx;
  background: linear-gradient(90deg, #34d399 0%, #10b981 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
