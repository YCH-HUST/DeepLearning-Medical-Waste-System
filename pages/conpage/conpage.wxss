  align-items: center;
  gap: 15rpx;
}

.classification-icon {
  font-size: 40rpx;
  width: 50rpx;
  text-align: center;
}

.classification-label {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 500;
}

.classification-value-container {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.classification-value {
  font-size: 32rpx;
  color: #10b981;
  font-weight: bold;
  text-shadow: none;
}

.confidence-unit {
  font-size: 24rpx;
  color: #64748B;
  opacity: 0.8;
}

.confidence-bar {
  margin-top: 15rpx;
}

/* 分类说明样式 */
.classification-info-card {
  background-color: #ffffff;
  border: 1px solid rgba(33, 150, 243, 0.15);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 25rpx;
  box-shadow: 0 8rpx 24rpx rgba(33, 150, 243, 0.06);
}

.info-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 15rpx;
  padding: 10rpx 0;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-icon {
  font-size: 32rpx;
  width: 40rpx;
  text-align: center;
}

.info-text {
  font-size: 26rpx;
  color: #64748B;
  line-height: 1.4;
