}

.classification-details {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.classification-icon-and-label {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.classification-icon {
  font-size: 40rpx;
  width: 50rpx;
  text-align: center;
}

.classification-label {
  font-size: 28rpx;
  color: #f8f8f8;
  font-weight: 500;
}

.classification-value-container {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.classification-value {
  font-size: 32rpx;
  color: #4caf50;
  font-weight: bold;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

.confidence-unit {
  font-size: 24rpx;
  color: #e0e0e0;
  opacity: 0.8;
}

.confidence-bar {
  margin-top: 15rpx;
}

/* 分类说明样式 */
.classification-info-card {
  background: linear-gradient(135deg, rgba(33, 150, 243, 0.1) 0%, rgba(33, 150, 243, 0.05) 100%);
  border: 1px solid rgba(33, 150, 243, 0.3);
  border-radius: 16rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(33, 150, 243, 0.2);
}

.info-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 15rpx;
  padding: 10rpx 0;
}

.info-item:last-child {
