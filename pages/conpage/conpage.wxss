}

.info-icon {
  font-size: 32rpx;
  width: 40rpx;
  text-align: center;
}

.info-text {
  font-size: 26rpx;
  color: #e0e0e0;
  line-height: 1.4;
  flex: 1;
}

.upload-section {
  margin: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 上传图片卡片美化 */
.upload-card {
