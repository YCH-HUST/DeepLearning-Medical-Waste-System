}

.upload-section {
  margin: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 上传图片卡片美化 */
.upload-card {
  background-color: #ffffff;
  border: 1px dashed rgba(76, 175, 80, 0.3);
  border-radius: 20rpx;
  padding: 40rpx 16rpx 30rpx 16rpx;
  margin-bottom: 35rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 0;
  margin-right: 0;
}
.upload-header {
