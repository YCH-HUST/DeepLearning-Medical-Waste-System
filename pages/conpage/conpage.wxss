  box-shadow: 0 4rpx 12rpx rgba(192, 108, 132, 0.13);
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 0;
  margin-right: 0;
}
.upload-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 30rpx;
}
.upload-icon {
  font-size: 48rpx;
  color: #c06c84;
}
.upload-title {
  font-size: 32rpx;
  color: #f8f8f8;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.upload-btn {
  margin: 24rpx 0 24rpx 0;
  width: 90%;
  height: 90rpx;
  background: linear-gradient(90deg, #e88e9d 0%, #c06c84 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(192, 108, 132, 0.18);
  transition: background 0.2s;
}
.upload-btn:active {
  background: linear-gradient(90deg, #c06c84 0%, #e88e9d 100%);
}
.preview-img {
  width: 380rpx;
  height: 380rpx;
  margin-top: 0;
  border-radius: 18rpx;
  border: 2rpx solid #e88e9d;
  box-shadow: 0 2rpx 12rpx rgba(192, 108, 132, 0.10);
  background: #fff;
  object-fit: contain;
}

/* 识别按钮美化 */
.recognize-btn {
  width: 180rpx;
  height: 80rpx;
  background: linear-gradient(90deg, #4caf50 0%, #43a047 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  border: none;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.18);
  transition: background 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}
.recognize-btn:active {
  background: linear-gradient(90deg, #43a047 0%, #4caf50 100%);
}

/* 识别中动画 */
.recognizing-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}
.recognizing-text {
  font-size: 28rpx;
  color: #4caf50;
  margin-bottom: 18rpx;
  font-weight: bold;
}
.recognizing-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e0e0e0;
  border-top: 6rpx solid #4caf50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  box-shadow: 0 0 18rpx rgba(76, 175, 80, 0.13);
}

/* 识别结果卡片美化 */
.result-card {
  background: linear-gradient(135deg, rgba(76, 175, 80, 0.10) 0%, rgba(76, 175, 80, 0.04) 100%);
  border: 1px solid rgba(76, 175, 80, 0.25);
  border-radius: 16rpx;
  padding: 30rpx 20rpx 20rpx 20rpx;
  margin-top: 10rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.13);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.result-header {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 18rpx;
}
.result-icon {
  font-size: 40rpx;
  color: #4caf50;
}
.result-title {
  font-size: 28rpx;
  color: #f8f8f8;
  font-weight: bold;
}
.result-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 18rpx;
}
.result-label {
  font-size: 32rpx;
  color: #4caf50;
  font-weight: bold;
  margin-bottom: 8rpx;
}
.result-confidence {
  font-size: 24rpx;
  color: #e0e0e0;
  opacity: 0.85;
}
.result-bar {
  width: 100%;
  margin-top: 8rpx;
}

/* 横向大图片预览，背景透明 */
.preview-img-wide {
  display: block;
  max-width: 100%;
  width: 100%;
  height: 260rpx;
  margin: 0 auto 20rpx auto;
  border-radius: 18rpx;
  border: 2rpx solid #e88e9d;
  box-shadow: 0 2rpx 12rpx rgba(192, 108, 132, 0.10);
  background: transparent;
  object-fit: contain;
}

/* 上传按钮组横向排列，居中 */
.upload-btn-group {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
  width: 100%;
}

/* 清除图片按钮风格与识别按钮一致，仅颜色不同 */
.clear-btn {
  width: 180rpx;
  height: 80rpx;
  background: linear-gradient(90deg, #bdbdbd 0%, #757575 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  border: none;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(120,120,120,0.13);
  transition: background 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}
.clear-btn:active {
  background: linear-gradient(90deg, #757575 0%, #bdbdbd 100%);
}

/* 拉宽识别结果卡片，居中 */
.result-card-wide {
  background: linear-gradient(135deg, rgba(76, 175, 80, 0.10) 0%, rgba(76, 175, 80, 0.04) 100%);
  border: 2rpx solid #4caf50;
  border-radius: 18rpx;
  padding: 30rpx 16rpx 20rpx 16rpx;
  margin-top: 10rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 2rpx 12rpx rgba(76, 175, 80, 0.10);
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 95%;
}
